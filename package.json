{
  "name": "selfmusic-studio",
  "version": "1.3.1",
  "description": "SelfMusic Studio desktop app for SunoAPI.org and KIE.AI",
  "author": "SelfMusic Studio",
  "homepage": "https://github.com/masadzim/SelfMusic-Studio",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "electron/main.cjs",
  "desktopName": "selfmusic-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/masadzim/SelfMusic-Studio.git"
  },
  "scripts": {
    "start": "electron .",
    "prepare:assets": "node scripts/prepare-tts-assets.mjs",
    "prepare:assets:check": "node scripts/prepare-tts-assets.mjs --check",
    "prepare:assets:win": "node scripts/prepare-tts-assets.mjs --platform win32-x64",
    "prepare:assets:check:win": "node scripts/prepare-tts-assets.mjs --check --platform win32-x64",
    "prune:ort": "node scripts/prune-onnxruntime.mjs",
    "test": "node scripts/verify-save-pipeline.cjs",
    "build:linux": "npm run prepare:assets:check && node scripts/prune-onnxruntime.mjs --target linux --arch x64 && electron-builder --linux AppImage",
    "build:linux:deb": "npm run prepare:assets:check && node scripts/prune-onnxruntime.mjs --target linux --arch x64 && electron-builder --linux deb && node scripts/finalize-deb.cjs dist/selfmusic-studio_$(node -p \"require('./package.json').version\")_amd64.deb",
    "build:windows": "npm run prepare:assets:check:win && node scripts/prune-onnxruntime.mjs --target win32 --arch x64 && electron-builder --win nsis",
    "build:mac": "npm run build:mac:arm64",
    "build:mac:arm64": "npm run prepare:assets:check && node scripts/prune-onnxruntime.mjs --target darwin --arch arm64 && electron-builder --mac --arm64",
    "build:mac:x64": "npm run prepare:assets:check && node scripts/prune-onnxruntime.mjs --target darwin --arch x64 && electron-builder --mac --x64",
    "build": "npm run build:linux && npm run build:windows",
    "release": "electron-builder --linux AppImage --win nsis --publish always",
    "release:linux": "electron-builder --linux AppImage --publish always",
    "release:windows": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.selfmusic.studio",
    "productName": "SelfMusic Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "SelfMusic-Studio.html",
      "Asset/**/*",
      "COPYING",
      "LICENSE",
      "COPYRIGHT-NOTICE.txt",
      "THIRD-PARTY-NOTICES.md",
      "resources/license.txt",
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/tts.cjs",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/tts",
        "to": "tts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "beforePack": "./scripts/stage-tts-assets.cjs",
    "afterPack": "./scripts/stage-tts-assets.cjs",
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/bin/**"
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "masadzim",
      "repo": "SelfMusic-Studio",
      "releaseType": "release"
    },
    "appImage": {
      "license": "resources/license.txt"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "Asset/icon.png",
      "syncDesktopName": true,
      "maintainer": "SelfMusic Studio"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "Asset/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "icon": "Asset/icon.png",
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "SelfMusic Studio memakai mikrofon hanya bila kamu merekam sampel suara untuk clone.",
        "NSSpeechRecognitionUsageDescription": "Tidak dipakai; hanya untuk Pryatinjau suara perangkat."
      }
    },
    "dmg": {
      "license": "resources/license.txt"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "resources/license.txt"
    }
  }
}
